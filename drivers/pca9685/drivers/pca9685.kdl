// The external `<pca9685>` driver: manifest only. The published
// `pwm-pca9685` 1.0.0 crate implements the part over `embedded-hal` 1.0 and
// `new(i2c, Address)` builds the controller in one call, so this `.kdl` is the
// whole driver. The `dependency` block writes that crate into the generated
// project's `Cargo.toml`; no `espforge-drivers` module or feature is involved.
//
// `Address` implements `From<u8>`, so the plain 7-bit address works and no
// address map is needed. `new` returns a `Result`, so `fallible` keeps its
// default.
driver "pca9685" {
    format_version 2
    summary "NXP PCA9685 16-channel PWM controller on I2C"
    description "Drives the sixteen PWM channels of an NXP PCA9685 over an I2C bus. `set_prescale` stops the oscillator, programs the frame-rate divisor and restarts it, `set_channel_on_off` writes a channel's 12-bit on and off counts, and `enable` wakes the chip. The Rust half is the published `pwm-pca9685` crate, so this manifest is the whole driver."
    category "actuator"

    dependency "pwm-pca9685" { version "1.0.0" }

    bus "i2c" {
        address allowed="0x40..=0x77"
    }

    codegen {
        runtime "blocking" {
            type "pwm_pca9685::Pca9685<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "pwm_pca9685::Pca9685::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the controller during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<pca9685 id=\"pwm\" bus=\"$i2c0\" address=\"0x40\" />"#
    see_also "peripherals/i2c"
}
