// The external `<sen6x>` driver: manifest only. The published `sen6x` 0.1.4
// crate implements the part over `embedded-hal` 1.0 and
// `blocking::Sen6x::new(delay, i2c)` takes the delay before the bus, so this
// `.kdl` is the whole driver. The `dependency` block writes that crate into
// the generated project's `Cargo.toml`; no `espforge-drivers` module or
// feature is involved.
//
// `new` returns the sensor directly, so `fallible #false`. Continuous
// measurement is started by a `then` step; `get_sample()` then reads the last
// nine values without changing the field's type.
driver "sen6x" {
    format_version 2
    summary "Sensirion SEN6x air-quality sensor on I2C"
    description "Reads particulate matter, temperature, humidity, VOC, NOx and CO2 from a Sensirion SEN6x over an I2C bus. `start_continuous_measurement()` starts the one-per-second cycle, and `get_sample()` sends the read-measured-values command and decodes the nine CRC-checked 16-bit words with the datasheet's scales. The Rust half is the published `sen6x` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "sen6x" { version "0.1.4" }

    bus "i2c" {
        address fixed="0x6B"
    }

    codegen {
        fallible #false
        map "delay" {
            "runtime" { expr "espforge_runtime::Delay::new()" }
        }
        runtime "blocking" {
            type "sen6x::blocking::Sen6x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>, espforge_runtime::Delay>"
            constructor "sen6x::blocking::Sen6x::new({delay}, {bus_device})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
            then {
                call "start_continuous_measurement()"
            }
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }
    attr "delay" kind="choice" default="runtime" {
        choices "runtime"
        help "The delay handle the driver takes; espforge always passes the runtime's own."
    }

    example "minimal" #"<sen6x id=\"air\" bus=\"$i2c0\" address=\"0x6B\" />"#
    see_also "peripherals/i2c"
}
