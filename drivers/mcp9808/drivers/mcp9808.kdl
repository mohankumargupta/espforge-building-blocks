// The external `<mcp9808>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "mcp9808" {
    format_version 2
    summary "Microchip MCP9808 temperature sensor on I2C"
    description "Reads the ambient temperature from a Microchip MCP9808 over an I2C bus. The driver checks the manufacturer and device identification registers and sets the resolution to 0.0625 C at construction, then reads the ambient register and decodes the 13-bit two's complement temperature. The Rust half is the `mcp9808-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "mcp9808-driver" {
        path "../mcp9808-driver"
    }

    bus "i2c" {
        address allowed="0x18..=0x1F"
    }

    codegen {
        runtime "blocking" {
            type "mcp9808_driver::Mcp9808<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "mcp9808_driver::Mcp9808::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<mcp9808 id=\"temperature\" bus=\"$i2c0\" address=\"0x18\" />"#
    see_also "peripherals/i2c"
}
