// The external `<aht20>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "aht20" {
    format_version 2
    summary "ASAIR AHT20 temperature and relative humidity sensor on I2C"
    description "Reads temperature and relative humidity over an I2C bus. The chip has no register pointer: 0x71 prepares the status byte, 0xBE 0x08 0x00 initializes a part that reports it is not calibrated, and 0xAC 0x33 0x00 triggers a measurement whose seven bytes are the status, 20 bits of humidity, 20 bits of temperature and the CRC-8. The Rust half is the `aht20-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "aht20-driver" {
        path "../aht20-driver"
    }

    bus "i2c" {
        address allowed="0x38..=0x38"
    }

    codegen {
        runtime "blocking" {
            type "aht20_driver::Aht20<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "aht20_driver::Aht20::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<aht20 id="climate" bus="$i2c0" address="0x38" />"#
    see_also "peripherals/i2c"
}
