// The external `<mcp23xxx>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "mcp23xxx" {
    format_version 2
    summary "Microchip MCP23017 16-bit I2C I/O expander driver"
    description "Drives the sixteen pins of an MCP23017 over an I2C bus, in the power-on IOCON.BANK = 0 register layout. The driver makes both ports outputs at construction, then sets per-port direction, pull-ups, output latches and reads the pins back through GPIO. The Rust half is the `mcp23xxx-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "expander"

    dependency "mcp23xxx-driver" {
        path "../mcp23xxx-driver"
    }

    bus "i2c" {
        address allowed="0x20..=0x27"
    }

    codegen {
        runtime "blocking" {
            type "mcp23xxx_driver::Mcp23xxx<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "mcp23xxx_driver::Mcp23xxx::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the expander during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<mcp23xxx id=\"io\" bus=\"$i2c0\" address=\"0x20\" />"#
    see_also "peripherals/i2c"
}
