// The external `<bme280_i2c>` driver. `codegen.feature` is absent, so the
// dependency below is written into the generated project's Cargo.toml instead
// of selecting an espforge-drivers feature.
//
// `bme280` 0.5.1's `i2c::BME280::new(i2c, address)` is infallible, so
// `fallible #false`; `init(&mut delay)` applies 2x T / 16x P / IIR 16, and the
// fixture calls it from `setup` before the first `measure`. Pressure comes back
// in pascals, which the fixture prints as hPa.
driver "bme280_i2c" {
    format_version 2
    summary "Bosch BME280 temperature, humidity and pressure sensor on I2C"
    description "Reads temperature, pressure and relative humidity from a BME280 over an I2C bus. The crate's `init()` reads the calibration block and configures 2x temperature oversampling, 16x pressure oversampling and the IIR filter; `measure()` then reads the eight data bytes at 0xF7 and applies the compensation. The Rust half is the published `bme280` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "bme280" { version "0.5.1" }

    bus "i2c" {
        address allowed="0x76..=0x77"
    }

    codegen {
        fallible #false
        runtime "blocking" {
            type "bme280::i2c::BME280<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "bme280::i2c::BME280::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<bme280_i2c id=\"climate\" bus=\"$i2c0\" address=\"0x76\" />"#
    example "alternate address" #"<bme280_i2c id=\"climate\" bus=\"$i2c0\" address=\"0x77\" />"#
    see_also "peripherals/i2c"
}
