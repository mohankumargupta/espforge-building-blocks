// The external `<hdc302x>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "hdc302x" {
    format_version 2
    summary "TI HDC302x temperature and relative humidity sensor on I2C"
    description "Reads temperature and relative humidity from a TI HDC302x over an I2C bus. The part is command-driven and has no register pointer: the driver sends the two-byte soft reset at construction, then triggers one on-demand measurement and reads the four answer bytes. The datasheet's conversions turn the two 16-bit counts into degrees Celsius and percent relative humidity. The Rust half is the `hdc302x-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "hdc302x-driver" {
        path "../hdc302x-driver"
    }

    bus "i2c" {
        address allowed="0x44..=0x47"
    }

    codegen {
        runtime "blocking" {
            type "hdc302x_driver::Hdc302x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "hdc302x_driver::Hdc302x::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<hdc302x id=\"climate\" bus=\"$i2c0\" address=\"0x44\" />"#
    see_also "peripherals/i2c"
}
