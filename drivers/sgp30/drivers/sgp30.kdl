// The external `<sgp30>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "sgp30" {
    format_version 2
    summary "Sensirion SGP30 air-quality sensor on I2C"
    description "Reads equivalent CO2 and total volatile organic compounds from a Sensirion SGP30 over an I2C bus. The driver initialises air quality measurement at construction, then sends the measure-IAQ command and decodes the six-byte answer: eCO2 in ppm and TVOC in ppb, each 16-bit big-endian with a CRC byte. The Rust half is the `sgp30-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "sgp30-driver" {
        path "../sgp30-driver"
    }

    bus "i2c" {
        address allowed="0x58..=0x58"
    }

    codegen {
        runtime "blocking" {
            type "sgp30_driver::Sgp30<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "sgp30_driver::Sgp30::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<sgp30 id=\"air\" bus=\"$i2c0\" address=\"0x58\" />"#
    see_also "peripherals/i2c"
}
