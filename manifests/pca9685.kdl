// The external `<pca9685>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "pca9685" {
    format_version 2
    summary "NXP PCA9685 16-channel PWM controller on I2C"
    description "Drives the sixteen PWM channels of an NXP PCA9685 over an I2C bus. The driver puts the part to sleep, programs the prescaler for its 50 Hz frame rate, and wakes it with auto-increment so a channel's four duty registers go out as one write. Setting a duty cycle writes the channel's on/off counts, with the full-on bit for 100 %. The Rust half is the `pca9685-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "actuator"

    dependency "pca9685-driver" {
        path "../pca9685-driver"
    }

    bus "i2c" {
        address allowed="0x40..=0x77"
    }

    codegen {
        runtime "blocking" {
            type "pca9685_driver::Pca9685<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "pca9685_driver::Pca9685::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the controller during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<pca9685 id=\"pwm\" bus=\"$i2c0\" address=\"0x40\" />"#
    see_also "peripherals/i2c"
}
