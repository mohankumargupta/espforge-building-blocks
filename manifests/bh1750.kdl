// The external `<bh1750>` driver: a project-local manifest, not a module in
// espforge-drivers. `codegen.feature` is absent, so the dependency below is
// written into the generated project's Cargo.toml instead of selecting an
// espforge-drivers feature.
driver "bh1750" {
    format_version 2
    summary "ROHM BH1750 ambient light sensor on I2C"
    description "Reads illuminance from a BH1750 over an I2C bus. The part takes one-byte commands and answers a measurement with two big-endian bytes. The driver powers it on at construction, then triggers a one-shot high-resolution measurement and converts the raw counts to lux by dividing by 1.2. The Rust half is the `bh1750-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "bh1750-driver" {
        path "../bh1750-driver"
    }

    bus "i2c" {
        address allowed="0x23..=0x23"
    }

    codegen {
        runtime "blocking" {
            type "bh1750_driver::Bh1750<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "bh1750_driver::Bh1750::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<bh1750 id=\"light\" bus=\"$i2c0\" address=\"0x23\" />"#
    see_also "peripherals/i2c"
}
