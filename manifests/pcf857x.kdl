// The external `<pcf857x>` driver: a project-local manifest, not a module in
// espforge-drivers. It is not manifest only yet: the published `pcf857x` 0.5.0
// crate takes its own `SlaveAddr` type, so the protocol stays in the
// `pcf857x-driver` crate beside this manifest. The `dependency` block points
// the generated project at that crate; no `espforge-drivers` feature is
// involved.
driver "pcf857x" {
    format_version 2
    summary "NXP PCF8574 8-bit quasi-bidirectional I2C I/O expander driver"
    description "Drives the eight pins of a PCF8574 over an I2C bus. The part has no register file: one byte written is the port's output latch and one byte read is the level on its pins, so the constructor sends no transaction. A written 0 drives a pin low and a written 1 only releases it to its pull-up, which is why a read of a released pin can still be low. The Rust half is the `pcf857x-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "expander"

    dependency "pcf857x-driver" {
        path "../pcf857x-driver"
    }

    bus "i2c" {
        address allowed="0x20..=0x27"
    }

    codegen {
        // `Pcf857x::new` cannot fail and writes nothing, so emission maps no
        // error.
        fallible #false
        runtime "blocking" {
            type "pcf857x_driver::Pcf857x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "pcf857x_driver::Pcf857x::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the expander during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<pcf857x id=\"io\" bus=\"$i2c0\" address=\"0x20\" />"#
    see_also "peripherals/i2c"
}
