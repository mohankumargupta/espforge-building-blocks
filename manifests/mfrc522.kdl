// The external `<mfrc522>` driver: manifest only (there is no bundled MFRC522
// driver). The published `mfrc522` 0.8.0 crate implements the reader over
// `embedded-hal` 1.0; its blocking SPI transport wraps the bus in its own
// `SpiInterface`, so this `.kdl` is the whole driver. The `dependency` block
// writes that crate into the generated project's `Cargo.toml`; no
// `espforge-drivers` module or feature is involved.
//
// `Mfrc522::new(comm)` returns an uninitialised reader and `init(self)` returns
// `Mfrc522<_, Initialized>`, so the `then` step rebinds and `type` names the
// post-init reader. The crate's optional `eh02` feature stays off.
driver "mfrc522" {
    format_version 2
    summary "NXP MFRC522 contactless reader with a MIFARE Classic card on SPI"
    description "Speaks the MFRC522's 4-wire SPI protocol: one address byte (register << 1, bit 7 set for a read), no dummy byte. `init()` soft-resets the reader, checks VersionReg (0x37) for 0x92 or 0x91, applies the standard timer/ASK/mode setup and switches the antenna on. `new_card_present()` runs REQA and `select()` runs the anticollision and select commands, returning the card's UID. The Rust half is the published `mfrc522` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "mfrc522" { version "0.8.0" }

    bus "spi" {
        mode 0
        frequency "1000kHz"
    }

    codegen {
        fallible #false
        runtime "blocking" {
            type "mfrc522::Mfrc522<mfrc522::comm::blocking::spi::SpiInterface<espforge_runtime::ConfiguredSpiDevice, mfrc522::comm::blocking::spi::DummyDelay>, mfrc522::Initialized>"
            constructor "mfrc522::Mfrc522::new(mfrc522::comm::blocking::spi::SpiInterface::new({bus_device}))"
            endpoint "espforge_runtime::ConfiguredSpiDevice"
            then {
                call "init()"
                rebind #true
            }
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the reader during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<mfrc522 id="reader" bus="$spi2" cs="7" />"#
    see_also "peripherals/spi"
}
