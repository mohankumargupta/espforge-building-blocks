// The external `<mcp9808>` driver: manifest only. The published `mcp9808`
// 0.4.0 crate implements the part over `embedded-hal` 1.0 and `new(i2c)`
// builds it in one call, so this `.kdl` is the whole driver. The `dependency`
// block writes that crate into the generated project's `Cargo.toml`; no
// `espforge-drivers` module or feature is involved.
//
// `mcp9808` 0.4.0's `MCP9808::new(i2c)` returns the driver directly and takes
// no address, so `fallible #false` and the manifest fixes the crate's default
// 0x18 (the crate's `set_address` is not expressible in a constructor).
driver "mcp9808" {
    format_version 2
    summary "Microchip MCP9808 temperature sensor on I2C"
    description "Reads the ambient temperature from a Microchip MCP9808 over an I2C bus. The crate reads the 16-bit ambient register, masks the alert flags and decodes the 13-bit two's complement temperature in 0.0625 C steps. Its `new()` takes no address, so the element is fixed at the crate's default 0x18. The Rust half is the published `mcp9808` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "mcp9808" { version "0.4.0" }

    bus "i2c" {
        address fixed="0x18"
    }

    codegen {
        fallible #false
        runtime "blocking" {
            type "mcp9808::MCP9808<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "mcp9808::MCP9808::new({bus_device})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<mcp9808 id=\"temperature\" bus=\"$i2c0\" address=\"0x18\" />"#
    see_also "peripherals/i2c"
}
