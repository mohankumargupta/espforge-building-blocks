// The external `<sen6x>` driver: a project-local manifest, not a module in
// espforge-drivers. It is not manifest only yet: the published `sen6x` 0.1.4
// crate takes the delay before the bus and returns the sensor without a
// `Result`, so the protocol stays in the `sen6x-driver` crate beside this
// manifest. The `dependency` block points the generated project at that crate;
// no `espforge-drivers` feature is involved.
driver "sen6x" {
    format_version 2
    summary "Sensirion SEN6x air-quality sensor on I2C"
    description "Reads particulate matter, temperature, humidity, VOC, NOx and CO2 from a Sensirion SEN6x over an I2C bus. The driver starts continuous measurement at construction, then sends the read-measured-values command and decodes the 27-byte SEN66 answer: nine 16-bit big-endian words with a CRC byte after each, converted with the datasheet's scales. The Rust half is the `sen6x-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "sen6x-driver" {
        path "../sen6x-driver"
    }

    bus "i2c" {
        address allowed="0x6B..=0x6B"
    }

    codegen {
        runtime "blocking" {
            type "sen6x_driver::Sen6x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "sen6x_driver::Sen6x::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<sen6x id=\"air\" bus=\"$i2c0\" address=\"0x6B\" />"#
    see_also "peripherals/i2c"
}
