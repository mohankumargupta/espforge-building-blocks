// The external `<ina219>` driver: a project-local manifest, not a module in
// espforge-drivers. It is not manifest only yet: the published `ina219` 0.2.1
// crate takes its own `ina219::address::Address`, so the protocol stays in the
// `ina219-driver` crate beside this manifest. The `dependency` block points
// the generated project at that crate; no `espforge-drivers` feature is
// involved.
driver "ina219" {
    format_version 2
    summary "TI INA219 current and power monitor on I2C"
    description "Measures bus voltage, shunt voltage, current and power with a TI INA219 over an I2C bus. The driver writes the configuration register and a calibration for a 0.1 ohm shunt at a 100 uA current LSB at construction, then reads the four data registers in one transaction and converts them with the datasheet's scale factors. The Rust half is the `ina219-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "ina219-driver" {
        path "../ina219-driver"
    }

    bus "i2c" {
        address allowed="0x40..=0x4F"
    }

    codegen {
        runtime "blocking" {
            type "ina219_driver::Ina219<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "ina219_driver::Ina219::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the monitor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<ina219 id=\"power\" bus=\"$i2c0\" address=\"0x40\" />"#
    see_also "peripherals/i2c"
}
