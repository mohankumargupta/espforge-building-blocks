// The external `<aip31068>` driver: manifest only. The published
// `i2c-character-display` 0.6.0 crate implements the controller over
// `embedded-hal` 1.0 and its `new(i2c, lcd_type, delay)` builds the display in
// one call, so this `.kdl` is the whole driver. The `dependency` block writes
// that crate into the generated project's `Cargo.toml`; no `espforge-drivers`
// module or feature is involved.
//
// `i2c-character-display` 0.6.0's `CharacterDisplayAIP31068::new(i2c,
// lcd_type, delay)` returns the display directly (the controller has a fixed
// address), so `fallible #false` and no `{address}` in the constructor. The
// crate's `init()` must run before the first write; the fixture calls it in
// `setup`, since it is a fallible step, not part of construction.
driver "aip31068" {
    format_version 2
    summary "AiP31068 16x2 character LCD controller on I2C"
    description "Writes text to a 16-character, 2-line character LCD over an I2C bus. The controller takes a control byte (0x00 for an instruction, 0x40 for display data) followed by the bytes it applies to; the crate's `init()` sends the AiP31068's 8-bit function set, display on, clear and entry mode, then `set_cursor` and `print` address a row and write. The Rust half is the published `i2c-character-display` crate, so this manifest is the whole driver."
    category "display"

    dependency "i2c-character-display" { version "0.6.0" }

    bus "i2c" {
        address fixed="0x3e"
    }

    codegen {
        fallible #false
        runtime "blocking" {
            type "i2c_character_display::CharacterDisplayAIP31068<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>, espforge_runtime::Delay>"
            constructor "i2c_character_display::CharacterDisplayAIP31068::new({bus_device}, i2c_character_display::LcdDisplayType::Lcd16x2, espforge_runtime::Delay::new())"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the panel during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<aip31068 id=\"lcd\" bus=\"$i2c0\" address=\"0x3E\" />"#
    see_also "peripherals/i2c"
}
