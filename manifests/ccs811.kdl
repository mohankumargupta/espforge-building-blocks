// The external `<ccs811>` driver: a project-local manifest, not a module in
// espforge-drivers. It is not manifest only yet: the published
// `embedded-ccs811` 1.0.0 crate needs an address map, an `nwake` pin and an
// `start_application()` rebind, so the protocol stays in the `ccs811-driver`
// crate beside this manifest. The `dependency` block points the generated
// project at that crate; no `espforge-drivers` feature is involved.
driver "ccs811" {
    format_version 2
    summary "AMS CCS811 eCO2 and TVOC air quality sensor on I2C"
    description "Reads equivalent CO2 and total volatile organic compounds from a CCS811 over an I2C bus. The driver checks the hardware id, requires the part to report a valid application without an error, starts the application firmware with APP_START when the part is still in boot mode, and asks for one measurement a second. Each read checks the status byte and takes the four big-endian result bytes: eCO2 in ppm and TVOC in ppb. The Rust half is the `ccs811-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "ccs811-driver" {
        path "../ccs811-driver"
    }

    bus "i2c" {
        address allowed="0x5A..=0x5B"
    }

    codegen {
        runtime "blocking" {
            type "ccs811_driver::Ccs811<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "ccs811_driver::Ccs811::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<ccs811 id=\"air\" bus=\"$i2c0\" address=\"0x5A\" />"#
    see_also "peripherals/i2c"
}
