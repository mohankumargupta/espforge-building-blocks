// The external `<bme280_spi>` driver: manifest only. The published `bme280`
// 0.5.1 crate implements the part over `embedded-hal` 1.0, and `new(spi)`
// plus a `then` step running `init` builds and configures it, so this `.kdl`
// is the whole driver. The `dependency` block writes that crate into the
// generated project's `Cargo.toml`; no `espforge-drivers` module or feature
// is involved.
//
// `bme280` 0.5.1's `spi::BME280::new(spi)` returns a `Result` (it reads the
// chip id and calibration), so the constructor stays fallible. `init(&mut
// delay)` applies the oversampling configuration; the fixture calls it from
// `setup` before the first `measure`. Pressure comes back in pascals.
driver "bme280_spi" {
    format_version 2
    summary "Bosch BME280 temperature, humidity and pressure sensor on SPI"
    description "Reads temperature, pressure and relative humidity from a BME280 over an SPI bus. The crate's `new()` checks the chip id, `init()` reads the calibration block and configures 2x temperature oversampling, 16x pressure oversampling and the IIR filter; `measure()` then reads the eight data bytes at 0xF7 (address with bit 7 set, one dummy byte) and applies the compensation. The Rust half is the published `bme280` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "bme280" { version "0.5.1" }

    bus "spi" {
        mode 0
        frequency "1000kHz"
    }

    codegen {
        runtime "blocking" {
            type "bme280::spi::BME280<espforge_runtime::ConfiguredSpiDevice>"
            constructor "bme280::spi::BME280::new({bus_device})"
            endpoint "espforge_runtime::ConfiguredSpiDevice"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<bme280_spi id=\"climate\" bus=\"$spi2\" cs=\"7\" />"#
    see_also "peripherals/spi"
}
