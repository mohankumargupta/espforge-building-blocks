// The external `<hdc302x>` driver: manifest only. The published `hdc302x`
// 0.5.0 crate implements the part over `embedded-hal` 1.0 and
// `new(i2c, delay, I2cAddr)` builds the sensor in one call, so this `.kdl` is
// the whole driver. The `dependency` block writes that crate into the
// generated project's `Cargo.toml`; no `espforge-drivers` module or feature is
// involved.
//
// `new` is infallible, so `fallible #false`. Its blocking API lives behind the
// crate's `blocking` feature (on by default) and its address is an enum, so
// `map "address"` covers the four values `0x44..=0x47`.
driver "hdc302x" {
    format_version 2
    summary "TI HDC302x temperature and relative humidity sensor on I2C"
    description "Reads temperature and relative humidity from a TI HDC302x over an I2C bus. `one_shot(LowPowerMode)` sends the two-byte measurement command, waits the conversion time and reads the two CRC-checked 16-bit counts; `centigrade()` and `humidity_percent()` apply the datasheet conversions. The Rust half is the published `hdc302x` crate, so this manifest is the whole driver."
    category "sensor"

    dependency "hdc302x" {
        version "0.5.0"
        default_features #false
        features "blocking"
    }

    bus "i2c" {
        address allowed="0x44..=0x47"
    }

    codegen {
        fallible #false
        map "delay" {
            "runtime" { expr "espforge_runtime::Delay::new()" }
        }
        map "address" {
            "0x44" { expr "hdc302x::I2cAddr::Addr00" }
            "0x45" { expr "hdc302x::I2cAddr::Addr01" }
            "0x46" { expr "hdc302x::I2cAddr::Addr10" }
            "0x47" { expr "hdc302x::I2cAddr::Addr11" }
        }
        runtime "blocking" {
            type "hdc302x::Hdc302x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>, espforge_runtime::Delay>"
            constructor "hdc302x::Hdc302x::new({bus_device}, {delay}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }
    attr "delay" kind="choice" default="runtime" {
        choices "runtime"
        help "The delay handle the driver takes; espforge always passes the runtime's own."
    }

    example "minimal" #"<hdc302x id=\"climate\" bus=\"$i2c0\" address=\"0x44\" />"#
    see_also "peripherals/i2c"
}
