// The external `<bme280_i2c>` driver: a project-local manifest, not a module
// in espforge-drivers (there is no bundled BME280 driver). `codegen.feature`
// is absent, so the dependency below is written into the generated project's
// Cargo.toml instead of selecting an espforge-drivers feature.
driver "bme280_i2c" {
    format_version 2
    summary "Bosch BME280 temperature, humidity and pressure sensor on I2C"
    description "Reads the eight data bytes at 0xF7 over an I2C bus: the register pointer, a repeated start, then pressure, temperature and humidity. The constructor checks ID (0xD0) for 0x60, reads the calibration block and puts the chip in normal mode. The Rust half is the `bme280-i2c-driver` crate beside this manifest, so the driver is external to espforge-drivers."
    category "sensor"

    dependency "bme280-i2c-driver" {
        path "../bme280-i2c-driver"
    }

    bus "i2c" {
        address allowed="0x76..=0x77"
    }

    codegen {
        runtime "blocking" {
            type "bme280_i2c_driver::Bme280I2c<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>>"
            constructor "bme280_i2c_driver::Bme280I2c::new({bus_device}, {address})"
            endpoint "espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>"
        }
    }

    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "`boot` builds the sensor during `Devices::new`; `deferred` stores the bus and constructs it in `init()`."
    }

    example "minimal" #"<bme280_i2c id="climate" bus="$i2c0" address="0x76" />"#
    example "alternate address" #"<bme280_i2c id="climate" bus="$i2c0" address="0x77" />"#
    see_also "peripherals/i2c"
}
